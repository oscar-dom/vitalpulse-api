# Copy this file to `.env` and adjust the values. `.env` is git-ignored.

# Runtime environment: development | test | production
# (in development, 500 responses include the stack trace; use production when deploying)
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# MongoDB Atlas connection string (Atlas > your cluster > Connect > Drivers).
# Keep the database name (/vitalpulse) before the "?": without it, data goes to a "test" database.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vitalpulse?retryWrites=true&w=majority

# Secret used to sign JWT access tokens (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Access token lifetime, in a format accepted by jsonwebtoken (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=1h

# Public address of the FHIR endpoint, without a trailing slash. Used to build absolute
# URLs: the Location header, Bundle.entry.fullUrl and the Bundle paging links.
FHIR_BASE_URL=http://localhost:3000/fhir

# Origin of the web client allowed to call the API (CORS)
CORS_ORIGIN=http://localhost:5173

# Minimum log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# First admin account, created with: npm run seed:admin
# (only needed for that script; the password follows the sign-up rules: 8-72 characters)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
